# Copy to .env for local runs. Nothing is read from .env automatically: export what you need.

# cpu, cuda or auto (default: auto)
# NECROHUB_DEVICE=auto

# DEBUG, INFO, WARNING or ERROR (default: INFO)
# NECROHUB_LOG_LEVEL=INFO

# Set to 1 so Hugging Face never touches the network (the tests need this)
# HF_HUB_OFFLINE=1

# Ollama server for the LLM realizer (generate.realizer: llm). Default: http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# Only for generate.llm.backend: gemini (optional, paid). Never commit a real key
# GEMINI_API_KEY=

# Serving (necrohub query, necrohub serve, necrohub index load)
# memory loads NECROHUB_INDEX_DIR; pgvector reads DATABASE_URL (default: memory)
# NECROHUB_STORE=memory
# NECROHUB_INDEX_DIR=data/serving/index
# Default: the index_version in the index directory's index.json
# NECROHUB_INDEX_VERSION=
# extractive (no LLM, default), ollama or gemini; NECROHUB_LLM_MODEL names the model
# NECROHUB_LLM=extractive
# NECROHUB_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# The UI talks to the API here (compose sets http://api:8000)
# NECROHUB_API_URL=http://localhost:8000
# Answer with Ollama in compose: NECROHUB_LLM=ollama docker compose --profile ollama up -d --wait
# params.yaml section embed picks the embedder; the API refuses an index built with another
# NECROHUB_PARAMS=params.yaml

# Local Postgres from compose.yaml (docker compose reads these). Placeholders: pick your own password
POSTGRES_USER=necrohub
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=necrohub
# DATABASE_URL=postgresql://necrohub:change-me-locally@localhost:5432/necrohub
